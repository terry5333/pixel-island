# Firebase Configuration (填入您的 Firebase 專案金鑰，若為空則自動進入本地 Mock 測試模式)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_URL=

# 管理員 Email 清單（逗號分隔，符合此 Email 的登入者自動具備 Admin 權限）
VITE_ADMIN_EMAILS=admin@pixelisland.com,your-email@gmail.com

# Cloudflare R2 設定
# R2 公開訪問網址（例如：https://pub-xxxxxx.r2.dev 或自訂網域 https://assets.yourdomain.com）
VITE_R2_PUBLIC_URL=https://pub-example.r2.dev

# Cloudflare Worker API 或 Presigned URL 上傳端點（選填，若無則支援直接貼上 R2 公開 URL 或本地預覽模式）
VITE_R2_UPLOAD_ENDPOINT=https://r2-upload-worker.your-subdomain.workers.dev/upload
VITE_R2_API_TOKEN=
